{
  "name": "metaplate",
  "version": "0.3.0",
  "description": "Composable, framework-neutral Open Graph image tooling for TypeScript.",
  "keywords": [
    "open-graph",
    "og-image",
    "nextjs",
    "social-image",
    "satori"
  ],
  "license": "MIT",
  "author": "Lawrence Norton",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js",
      "default": "./dist/render.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.js",
      "default": "./dist/fonts.js"
    },
    "./png": {
      "types": "./dist/png.d.ts",
      "import": "./dist/png.js",
      "default": "./dist/png.js"
    }
  },
  "bin": {
    "metaplate": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm pack --dry-run",
    "check:package": "node scripts/verify-package.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@resvg/resvg-js": ">=2.6.2",
    "next": ">=15.0.0",
    "react": ">=18.2.0",
    "satori": ">=0.33.3"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-js": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "satori": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@fontsource/inter": "^5.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "eslint": "^10.0.0",
    "next": "^16.1.0",
    "react": "^19.1.0",
    "satori": "^0.33.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.41.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lnorton89/metaplate.git"
  },
  "bugs": {
    "url": "https://github.com/lnorton89/metaplate/issues"
  },
  "homepage": "https://github.com/lnorton89/metaplate#readme"
}
