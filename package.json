{
  "name": "metaplate",
  "version": "0.1.0",
  "description": "Composable, verifiable Open Graph image tooling for Next.js.",
  "keywords": ["open-graph", "og-image", "nextjs", "social-image", "satori"],
  "license": "MIT",
  "author": "Lawrence Norton",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./next": { "types": "./dist/next.d.ts", "import": "./dist/next.js" },
    "./fonts": { "types": "./dist/fonts.d.ts", "import": "./dist/fonts.js" },
    "./png": { "types": "./dist/png.d.ts", "import": "./dist/png.js" }
  },
  "bin": { "metaplate": "./dist/cli.js" },
  "scripts": {
    "build": "tsup",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm pack --dry-run",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "eslint": "^10.0.0",
    "next": "^16.1.0",
    "react": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.41.0",
    "vitest": "^4.1.0"
  },
  "overrides": { "esbuild": "^0.28.2" },
  "publishConfig": { "access": "public", "provenance": true },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lnorton89/metaplate.git"
  },
  "bugs": { "url": "https://github.com/lnorton89/metaplate/issues" },
  "homepage": "https://github.com/lnorton89/metaplate#readme"
}
