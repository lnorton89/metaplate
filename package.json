{
  "name": "metaplate",
  "version": "0.6.0",
  "description": "Composable, framework-neutral Open Graph image tooling for TypeScript.",
  "keywords": [
    "open-graph",
    "og-image",
    "nextjs",
    "social-image",
    "satori"
  ],
  "license": "MIT",
  "author": "Lawrence Norton",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js",
      "default": "./dist/render.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.js",
      "default": "./dist/fonts.js"
    },
    "./font-data": {
      "types": "./dist/font-data.d.ts",
      "import": "./dist/font-data.js",
      "default": "./dist/font-data.js"
    },
    "./png": {
      "types": "./dist/png.d.ts",
      "import": "./dist/png.js",
      "default": "./dist/png.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js",
      "default": "./dist/image.js"
    }
  },
  "bin": {
    "metaplate": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "check": "npm run lint && npm run check:duplicates && npm run check:release-notes && npm run typecheck && npm run typecheck:examples && npm test && npm run build && npm pack --dry-run",
    "check:duplicates": "jscpd src scripts tests examples --min-lines 8 --min-tokens 60 --reporters console --ignore \"**/fixtures/**\" --threshold 0",
    "check:package": "node scripts/verify-package.mjs",
    "check:release-notes": "node scripts/validate-release-notes.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json --noEmit"
  },
  "peerDependencies": {
    "@resvg/resvg-js": ">=2.6.2 <3",
    "next": ">=16.3.2 <17",
    "react": ">=18.2.0 <20",
    "satori": ">=0.33.3 <0.34"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@fontsource/inter": "^5.2.8",
    "@react-router/dev": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "astro": "7.2.6",
    "eslint": "^10.0.0",
    "express": "5.2.1",
    "jscpd": "5.0.16",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-router": "7.18.2",
    "satori": "0.33.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.41.0",
    "vite": "7.3.6",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lnorton89/metaplate.git"
  },
  "bugs": {
    "url": "https://github.com/lnorton89/metaplate/issues"
  },
  "homepage": "https://github.com/lnorton89/metaplate#readme"
}
