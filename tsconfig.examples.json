{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "types": ["node", "react"],
    // Examples import the published entry points; map them at the source so a
    // rename or signature change breaks the example rather than a consumer.
    "paths": {
      "metaplate": ["./src/index.ts"],
      "metaplate/next": ["./src/next.tsx"],
      "metaplate/node": ["./src/node.ts"],
      "metaplate/render": ["./src/render.ts"],
      "metaplate/fonts": ["./src/fonts.ts"],
      "metaplate/png": ["./src/png.ts"],
      "metaplate/image": ["./src/image.ts"]
    }
  },
  "include": ["examples"]
}
